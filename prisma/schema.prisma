// Schema de base de datos para F5 App
// Desde Prisma 7, la URL de conexión NO va acá — vive en prisma.config.ts
// (en la raíz del proyecto) y en el driver adapter que arma PrismaService.
//
// Ejecutar en tu entorno local:
//   npx prisma generate
//   npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GroupRole {
  ADMIN
  MEMBER
}

enum TeamSide {
  A
  B
}

enum MatchType {
  F5
  F6
  F7
}

/// Cuenta de usuario, autenticada por email + contraseña. La contraseña se
/// fija en el primer login con ese email (no hay registro separado) — si
/// alguien la olvida, tiene que contactar al dueño de la app (fuera del
/// sistema, no hay flujo automático de recuperación).
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  /// Apodo opcional — se muestra como Nombre "Apodo" en toda la app.
  nickname           String?
  passwordHash       String?
  /// No-nulo mientras hay una sesión activa en algún dispositivo. Se limpia
  /// al hacer logout, o manualmente por el dueño de la app (POST
  /// /auth/admin/clear-session) si alguien perdió el acceso a su dispositivo.
  activeSessionToken String?
  avatarUrl          String?
  /// Id del equipo elegido en el perfil (ver la lista fija de equipos del
  /// lado de Flutter) — solo cambia el acento de color de la app, no
  /// tiene ninguna otra lógica asociada.
  favoriteTeamId     String?
  createdAt          DateTime @default(now())

  memberships    GroupMembership[]
  ownedGroups    Group[]           @relation("GroupOwner")
  linkedPlayers  Player[]
  createdMatches Match[]
  /// Conversaciones donde este user es "el miembro" (el lado no-capitán).
  conversationsAsMember Message[] @relation("MemberConversations")
  /// Mensajes puntuales que mandó (puede ser como miembro, o como capitán
  /// respondiendo).
  sentMessages          Message[] @relation("SentMessages")
}

/// Un mensaje dentro de una conversación entre UN miembro (no-capitán) y
/// el/los capitán(es) del grupo. `memberId` identifica la conversación
/// (siempre el mismo, sea quien sea que esté mandando el mensaje puntual);
/// `senderId` es quién mandó ESTE mensaje en particular.
model Message {
  id        String   @id @default(cuid())
  groupId   String
  memberId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  group  Group @relation(fields: [groupId], references: [id])
  member User  @relation("MemberConversations", fields: [memberId], references: [id])
  sender User  @relation("SentMessages", fields: [senderId], references: [id])

  @@index([groupId, memberId])
}

/// Un grupo de amigos/liga. Tiene su propia configuración de ELO,
/// su propio pool de jugadores y su propio historial de partidos.
model Group {
  id           String   @id @default(cuid())
  name         String
  inviteCode   String   @unique
  ownerId      String
  /// Dirección de la cancha (texto libre) — se usa para armar el link a
  /// Google Maps que ven todos los miembros. Solo el capitán la edita.
  venueAddress String?
  owner        User     @relation("GroupOwner", fields: [ownerId], references: [id])
  createdAt    DateTime @default(now())

  memberships GroupMembership[]
  players     Player[]
  matches     Match[]
  eloConfig   EloConfig?
  messages    Message[]
}

/// Relación N:M entre User y Group, con rol.
model GroupMembership {
  id       String    @id @default(cuid())
  userId   String
  groupId  String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
}

/// Ficha de jugador dentro de un grupo. Puede existir sin User vinculado
/// (jugador "invitado" cargado manualmente) y vincularse después.
model Player {
  id            String   @id @default(cuid())
  groupId       String
  linkedUserId  String?
  name          String
  elo           Float    @default(1500)
  matchesPlayed Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  group          Group             @relation(fields: [groupId], references: [id])
  linkedUser     User?             @relation(fields: [linkedUserId], references: [id])
  matchParticipations MatchTeamPlayer[]
}

/// Un partido cargado dentro de un grupo. Guarda solo el resultado
/// agregado por equipo (sin goles/asistencias individuales ni posiciones).
model Match {
  id              String    @id @default(cuid())
  groupId         String
  matchType       MatchType
  date            DateTime  @default(now())
  location        String?
  scoreA          Int
  scoreB          Int
  createdByUserId String
  createdAt       DateTime  @default(now())

  group          Group             @relation(fields: [groupId], references: [id])
  createdBy      User              @relation(fields: [createdByUserId], references: [id])
  teamPlayers    MatchTeamPlayer[]
}

/// Jugador participante de un partido puntual, con snapshot de su ELO
/// antes/después para poder auditar y graficar evolución histórica.
model MatchTeamPlayer {
  id        String   @id @default(cuid())
  matchId   String
  playerId  String
  team      TeamSide
  eloBefore Float
  eloAfter  Float
  eloDelta  Float

  match  Match  @relation(fields: [matchId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
}

/// Configuración de la fórmula de ELO, particular a cada grupo.
model EloConfig {
  id                   String @id @default(cuid())
  groupId              String @unique
  kFactorNew           Float  @default(40)
  kFactorMid           Float  @default(25)
  kFactorVeteran       Float  @default(15)
  newThreshold         Int    @default(10)
  veteranThreshold     Int    @default(30)
  goalDiffWeight       Float  @default(0.15)
  maxGoalDiffMultiplier Float @default(1.3)

  group Group @relation(fields: [groupId], references: [id])
}
